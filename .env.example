# Telegram bot token from @BotFather
BOT_TOKEN=your_bot_token_here

# Admin user IDs (comma-separated)
ADMIN_IDS=123456789,987654321

# Required channel for join enforcement (e.g. @my_channel)
CHANNEL_USERNAME=@your_channel

# SQLite database path
DB_PATH=data/users.db

# Download directory
DOWNLOAD_DIR=downloads

# Optional cookies file (for age-restricted/limited sites)
COOKIES_FILE=cookies.txt

# Default user language (fa or en)
DEFAULT_LANG=fa

# Default audio quality (128, 192, 320)
DEFAULT_QUALITY=192

# Max download size in MB
MAX_FILE_SIZE_MB=50

# Download retry count and delay between attempts (seconds)
DOWNLOAD_RETRIES=3
DOWNLOAD_DELAY=2

# Max search results shown per query
MAX_SEARCH_RESULTS=5
